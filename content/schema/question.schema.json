{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chem-lab-g9.example/schema/question.schema.json",
  "title": "ChemLab-G9 Question",
  "type": "object",
  "required": ["id", "type", "prompt", "answer", "knowledgePoints"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "type": { "enum": ["single-choice", "multiple-choice", "short-answer", "ordering", "observation"] },
    "prompt": { "type": "string", "minLength": 1 },
    "options": { "type": "array", "items": { "type": "string" } },
    "answer": {},
    "explanation": { "type": "string" },
    "knowledgePoints": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "misconceptions": { "type": "array", "items": { "type": "string" } },
    "difficulty": { "enum": ["easy", "medium", "hard"] },
    "evidence": { "type": "string" },
    "transfer": { "type": "string" }
  },
  "additionalProperties": true
}
