        {
          "step": 2,
          "action": "在火焰上方罩一个干冷的烧杯",
          "record": "观察烧杯内壁变化"
        },
        {
          "step": 3,
          "action": "迅速将烧杯倒转，加入少量澄清石灰水振荡",
          "record": "观察石灰水变化"
        }
      ],
      "observationGuidance": [
        "甲烷燃烧产生淡蓝色火焰",
        "烧杯内壁出现水雾",
        "澄清石灰水变浑浊"
      ],
      "conclusion": "甲烷燃烧生成水和二氧化碳：CH₄ + 2O₂ → CO₂ + 2H₂O。这是最简单的有机物的燃烧反应。"
    }
  ],
