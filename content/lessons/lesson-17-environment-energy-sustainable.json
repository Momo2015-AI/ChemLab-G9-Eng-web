{
  "id": "lesson-17-environment-energy-sustainable",
  "sequenceNumber": 28,
  "day": "28",
  "title": "能源与环境",
  "module": "unit-07-fuels-and-energy",
  "semester": "upper",
  "unitId": "u07",
  "duration": "45 分钟",
  "description": "理解化石燃料燃烧对环境的影响，认识清洁能源的重要性，树立可持续发展理念。",
  "status": "ready",
  "releaseStatus": "ready",
  "learningObjectives": [
    "理解化石燃料燃烧产生的主要污染物及其环境影响。",
    "认识清洁能源的种类和优势。",
    "树立节约能源、保护环境的可持续发展理念。"
  ],
  "knowledgePoints": ["environmental-impact"],
  "prerequisites": ["lesson-15-fossil-fuels-energy", "lesson-14-combustion-fire-extinguishing"],
  "misconceptionIds": [],
  "guidedLearning": {
    "stepCount": 8,
    "steps": [
      {
        "id": "L25-S01",
        "title": "情境引入：全球变暖的困扰",
        "type": "engage",
        "body": [
          "近年来极端天气频发：高温热浪、暴雨洪涝、冰川融化。",
          "这些现象与什么有关？人类活动如何影响地球环境？",
          "化学在解决环境问题中扮演什么角色？"
        ],
        "knowledgePoints": ["environmental-impact"],
        "check": {
          "question": "下列气体中，导致温室效应最主要的是？",
          "options": ["O₂", "N₂", "CO₂", "H₂"],
          "answer": 2,
          "explanation": "CO₂是主要的温室气体，过量排放导致全球变暖。"
        }
      },
      {
        "id": "L25-S02",
        "title": "核心概念：化石燃料燃烧的环境影响",
        "type": "content",
        "body": [
          "CO₂排放：温室效应，全球气候变暖。",
          "SO₂排放：酸雨，腐蚀建筑物，破坏土壤和水体生态。",
          "NOx排放：酸雨、光化学烟雾。",
          "粉尘（PM2.5）：呼吸系统疾病，能见度下降。",
          "不完全燃烧产生CO：有毒气体。"
        ],
        "knowledgePoints": ["environmental-impact"],
        "check": {
          "question": "下列污染物中，主要导致酸雨的是？",
          "options": ["CO₂", "SO₂", "N₂", "O₂"],
          "answer": 1,
          "explanation": "SO₂和NOx溶于雨水形成酸雨。"
        }
      },
      {
        "id": "L25-S03",
        "title": "核心概念：汽车尾气的治理",
        "type": "content",
        "body": [
          "汽车尾气主要污染物：CO、NOx、未燃尽碳氢化合物、含铅化合物（已淘汰）。",
          "催化转换器：将CO和NOx转化为CO₂和N₂。",
          "使用无铅汽油：保护催化转换器。",
          "推广新能源汽车：从源头减少污染。"
        ],
        "knowledgePoints": ["environmental-impact"],
        "check": null
      },
      {
        "id": "L25-S04",
        "title": "核心概念：清洁能源",
        "type": "content",
        "body": [
          "太阳能：取之不尽，清洁无污染。",
          "风能：清洁，但受地理和天气限制。",
          "氢能：燃烧只生成水，最清洁，但储运成本高。",
          "核能：能量密度高，但有核废料处理问题。",
          "生物质能：可再生，但燃烧仍有排放。"
        ],
        "knowledgePoints": ["environmental-impact"],
        "check": {
          "question": "下列能源中，最清洁的是？",
          "options": ["煤", "石油", "天然气", "氢气"],
          "answer": 3,
          "explanation": "氢气燃烧只生成水，是最清洁的燃料。"
        }
      },
      {
        "id": "L25-S05",
        "title": "核心概念：节能减排措施",
        "type": "content",
        "body": [
          "提高燃烧效率：使燃料充分燃烧，减少CO和炭黑排放。",
          "开发新能源：减少对化石燃料的依赖。",
          "植树造林：吸收CO₂，净化空气。",
          "绿色出行：骑自行车、乘坐公共交通。",
          "节约用电：减少发电的化石燃料消耗。"
        ],
        "knowledgePoints": ["environmental-impact"],
        "check": null
      },
      {
        "id": "L25-S06",
        "title": "中国承诺：双碳目标",
        "type": "content",
        "body": [
          "2030年前实现碳达峰：CO₂排放量达到峰值后开始下降。",
          "2060年前实现碳中和：排放的CO₂被吸收平衡，净排放为零。",
          "途径：发展新能源、提高能效、碳捕获与封存（CCS）、植树造林。",
          "这是中国的庄严承诺，也是全球气候治理的重要举措。"
        ],
        "knowledgePoints": ["environmental-impact"],
        "check": {
          "question": "我国承诺实现碳中和的年份是？",
          "options": ["2030年", "2040年", "2050年", "2060年"],
          "answer": 3,
          "explanation": "中国承诺2030年碳达峰、2060年碳中和。"
        }
      },
      {
        "id": "L25-S07",
        "title": "讨论：能源与发展的平衡",
        "type": "inquiry",
        "body": [
          "经济发展离不开能源，但能源使用带来环境问题。",
          "如何在发展和环保之间找到平衡？",
          "作为中学生，我们能做什么？"
        ],
        "knowledgePoints": ["environmental-impact"],
        "check": null
      },
      {
        "id": "L25-S08",
        "title": "知识小结",
        "type": "summary",
        "body": [
          "化石燃料燃烧产生CO₂、SO₂、NOx、粉尘等污染物。",
          "清洁能源包括氢能、太阳能、风能等。",
          "我国承诺2030碳达峰、2060碳中和。",
          "节能减排需要从政府、企业到个人的共同努力。"
        ],
        "knowledgePoints": ["environmental-impact"],
        "check": null
      }
    ]
  },
