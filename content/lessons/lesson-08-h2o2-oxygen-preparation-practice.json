      "difficulty": "medium",
      "knowledgePoint": "oxygen-catalyst",
      "question": "下列物质中，能作为过氧化氢分解催化剂的是？",
      "options": [
        "NaCl",
        "MnO₂",
        "CuSO₄晶体",
        "CaCO₃"
      ],
      "answer": 1,
      "explanation": "MnO₂是过氧化氢分解最常用的催化剂；NaCl和CaCO₃不能催化该反应。",
      "knowledgeIds": [
        "oxygen-catalyst"
      ]
    },
