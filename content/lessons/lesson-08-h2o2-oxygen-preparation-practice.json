      "knowledgePoint": "oxygen-preparation-h2o2",
      "question": "过氧化氢分解制取氧气的化学方程式为？",
      "options": [
        "H₂O₂ → H₂O + O₂",
        "2H₂O₂ → 2H₂O + O₂↑",
        "H₂O₂ → H₂ + O₂",
        "2H₂O₂ → 2H₂ + O₂↑"
      ],
      "answer": 1,
      "explanation": "过氧化氢分解：2H₂O₂ → 2H₂O + O₂↑，MnO₂作催化剂。",
      "knowledgeIds": [
        "oxygen-preparation-h2o2"
      ]
    },
