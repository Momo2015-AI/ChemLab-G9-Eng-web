  "questions": [
    {
      "id": "L27-P01",
      "type": "concept",
      "difficulty": "basic",
      "question": "化学反应前后，一定不变的是？",
      "options": [
        "分子种类",
        "物质种类",
        "原子种类和数目",
        "物质状态"
      ],
      "answer": 2,
      "explanation": "化学反应前后，原子的种类和数目不变，分子种类和物质种类改变。",
      "knowledgeIds": [
        "law-of-mass-conservation"
      ]
    },
    {
      "id": "L27-P02",
      "type": "concept",
      "difficulty": "basic",
      "question": "水电解反应中，发生改变的是？",
      "options": [
        "氢原子数目",
        "氧原子数目",
        "水分子种类",
        "氢氧原子总数"
      ],
      "answer": 2,
      "explanation": "水电解时水分子破裂，氢原子和氧原子重新组合成氢分子和氧分子。",
      "knowledgeIds": [
        "law-of-mass-conservation",
        "electrolysis-experiment"
      ]
    },
    {
      "id": "L27-P03",
      "type": "concept",
      "difficulty": "medium",
      "question": "某反应：2A+B→C，10g A与5g B恰好完全反应，生成C的质量是？",
      "options": [
        "5g",
        "10g",
        "15g",
        "20g"
      ],
      "answer": 2,
      "explanation": "根据质量守恒：10g+5g=15g C。",
      "knowledgeIds": [
        "law-of-mass-conservation"
      ]
    },
    {
      "id": "L27-P04",
      "type": "concept",
      "difficulty": "medium",
      "question": "下列变化中，从微观角度看，原子总数发生变化的是？",
      "options": [
        "碘升华",
        "水电解",
        "铁生锈",
        "干冰升华"
      ],
      "answer": 1,
      "explanation": "水电解是化学变化，分子重组但原子总数不变；其他选项为物理变化。",
      "trick": true,
      "knowledgeIds": [
        "law-of-mass-conservation"
      ]
    },
    {
