      "id": "L10-Q01",
      "type": "calculation",
      "question": "H₂O的相对分子质量是？",
      "options": ["16", "17", "18", "32"],
      "answer": 2,
      "knowledgeIds": ["relative-molecular-mass"],
      "knowledgePoints": ["relative-molecular-mass"],
      "explanation": "H₂O的相对分子质量 = 1×2 + 16 = 18。"
    },
    {
      "id": "L10-Q02",
      "type": "calculation",
      "question": "CO₂中碳元素和氧元素的质量比是？",
      "options": ["1:1", "1:2", "3:8", "12:16"],
      "answer": 2,
      "knowledgeIds": ["mass-ratio"],
      "knowledgePoints": ["mass-ratio"],
      "explanation": "CO₂中C:O质量比 = 12:(16×2) = 12:32 = 3:8。"
    },
    {
      "id": "L10-Q03",
      "type": "calculation",
      "question": "CaCO₃中钙元素的质量分数是？",
      "options": ["20%", "30%", "40%", "50%"],
      "answer": 2,
      "knowledgeIds": ["mass-fraction"],
      "knowledgePoints": ["mass-fraction"],
      "explanation": "CaCO₃相对分子质量 = 40+12+16×3 = 100，钙元素质量分数 = 40/100 × 100% = 40%。"
    },
    {
      "id": "L10-Q04",
      "type": "concept",
      "question": "化学反应前后，一定不变的是？",
      "options": ["分子种类", "原子种类", "物质种类", "分子数目"],
      "answer": 1,
      "knowledgeIds": ["law-conservation"],
      "knowledgePoints": ["law-conservation"],
      "explanation": "质量守恒定律：化学反应前后，原子的种类、数目、质量都不变；分子种类和物质种类一定改变。"
    },
    {
      "id": "L10-Q05",
      "type": "concept",
      "question": "下列现象能用质量守恒定律解释的是？",
