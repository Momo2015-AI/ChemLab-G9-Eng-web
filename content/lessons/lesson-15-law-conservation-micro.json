  "guidedLearning": {
    "stepCount": 8,
    "steps": [
      {
        "id": "L27-S01",
        "title": "复习引入：为什么质量守恒？",
        "type": "engage",
        "body": [
          "我们已知道化学反应前后质量守恒。",
          "但为什么守恒？是什么在反应前后保持不变？"
        ],
        "knowledgePoints": [
          "law-conservation"
        ],
        "check": {
          "question": "质量守恒定律的微观本质是？",
          "options": [
            "分子种类不变",
            "原子种类、数目、质量不变",
            "物质种类不变",
            "体积不变"
          ],
          "answer": 1,
          "explanation": "化学反应前后，原子的种类、数目、质量都不变，只是重新组合。"
        }
      },
      {
        "id": "L27-S02",
        "title": "核心概念：原子是化学变化中的最小粒子",
        "type": "content",
        "body": [
          "化学变化的实质：分子分裂成原子，原子重新组合成新分子。",
          "原子是化学变化中的最小粒子，反应前后原子本身不变。",
          "三不变：原子种类不变、原子数目不变、原子质量不变。"
        ],
        "knowledgePoints": [
          "law-conservation"
        ],
        "check": {
          "question": "化学反应前后，下列各项一定不变的是？①原子种类②原子数目③分子种类④物质种类",
          "options": [
            "①②",
            "①②③",
            "③④",
            "①②③④"
          ],
          "answer": 0,
          "explanation": "化学反应前后原子种类和数目不变，分子种类和物质种类一定改变。"
        }
      },
      {
        "id": "L27-S03",
        "title": "微观模拟：水电解的反应过程",
        "type": "content",
        "body": [
          "水电解：2H₂O → 2H₂ + O₂。",
          "反应前：2个水分子（4个H原子+2个O原子）。",
          "反应后：2个氢分子（4个H原子）+ 1个氧分子（2个O原子）。",
          "原子重新组合，总数不变。"
        ],
        "knowledgePoints": [
          "law-conservation"
        ],
        "check": null
      },
      {
        "id": "L27-S04",
        "title": "误区警示：原子不会被消灭",
        "type": "misconception",
        "body": [
          "误区：化学反应中原子可以被消灭或创生。",
          "纠正：化学反应只是原子的重新组合，原子本身不会消失或产生。核反应不属于化学反应。"
        ],
        "knowledgePoints": [
          "law-conservation"
        ],
        "check": {
          "question": "下列关于化学反应中原子的说法正确的是？",
          "options": [
            "原子可以被消灭",
            "原子可以创生",
            "原子种类和数目不变",
            "原子质量可能改变"
          ],
          "answer": 2,
          "explanation": "化学反应前后，原子的种类、数目、质量均不变。"
        }
      },
      {
        "id": "L27-S05",
        "title": "应用：解释燃烧后的灰烬质量",
        "type": "application",
        "body": [
          "木柴燃烧后灰烬质量减少：碳转化为CO₂气体逸散。",
          "镁条燃烧后固体质量增加：镁结合了空气中的氧气。",
          "两种现象都符合质量守恒——只需考虑所有参与反应的物质。"
        ],
        "knowledgePoints": [
          "law-conservation"
        ],
        "check": {
          "question": "镁条燃烧后固体质量增加，这是因为？",
          "options": [
            "质量守恒定律不适用于此反应",
            "镁结合了空气中的氧气",
            "生成了新的原子",
            "氧气被消耗所以质量增加"
          ],
          "answer": 1,
          "explanation": "镁与氧气反应生成氧化镁，固体质量 = 镁质量 + 氧质量，总质量守恒。"
        }
      },
      {
        "id": "L27-S06",
        "title": "应用边界：质量守恒的适用范围",
        "type": "content",
        "body": [
          "适用范围：所有化学反应。",
          "不适用：物理变化（如状态变化）、核反应。",
          "注意：质量守恒指“参加反应”的物质，未参与的不计入。"
        ],
        "knowledgePoints": [
          "law-conservation"
        ],
        "check": null
      },
      {
        "id": "L27-S07",
        "title": "练习：根据质量守恒推断物质组成",
        "type": "practice",
        "body": [
          "已知：A + B → C + D，10g A与5g B完全反应生成3g C。",
          "求生成D的质量：10+5-3 = 12g。",
          "推断：若D由C和E组成，可根据质量关系推算E的质量。"
        ],
        "knowledgePoints": [
          "law-conservation"
        ],
        "check": null
      },
      {
        "id": "L27-S08",
        "title": "知识小结",
        "type": "summary",
        "body": [
          "质量守恒的微观原因：化学反应前后原子三不变。",
          "化学变化的实质：分子分裂为原子，原子重新组合。",
          "应用：解释质量变化、推断物质组成。",
          "适用边界：仅限化学变化。"
        ],
        "knowledgePoints": [
          "law-conservation"
        ],
        "check": null
      }
    ]
  },
