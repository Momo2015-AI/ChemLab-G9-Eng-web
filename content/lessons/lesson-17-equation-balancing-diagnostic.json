    {
      "id": "L29-D01",
      "type": "concept",
      "difficulty": "medium",
      "question": "小明为了配平H₂O→H₂+O₂，将水改写成H₂O₂。他的错误在于？",
      "options": [
        "没有配平氢原子",
        "改变化学式下标，违背客观事实",
        "缺少反应条件",
        "氧气应该标↑"
      ],
      "answer": 1,
      "explanation": "改下标改变了水的化学式，H₂O₂是过氧化氢而非水。正确：2H₂O→2H₂↑+O₂↑（通电）。",
      "errorType": "mc-balance-by-subscript",
      "remediationStep": "L29-S05",
      "knowledgeIds": [
        "equation-balancing"
      ]
    },
    {
      "id": "L29-D02",
      "type": "concept",
      "difficulty": "medium",
      "question": "配平以下方程式：__Fe₂O₃+__CO→__Fe+__CO₂（高温），正确的系数是？",
      "options": [
        "1,1,1,1",
        "1,3,2,3",
        "2,3,2,3",
        "1,2,2,2"
      ],
      "answer": 1,
      "explanation": "Fe₂O₃+3CO→2Fe+3CO₂。Fe守恒：左边2个→右边2Fe；O守恒：3+3=6→右边3×2=6。",
      "knowledgeIds": [
        "equation-balancing"
      ]
    },
    {
      "id": "L29-D03",
      "type": "concept",
      "difficulty": "hard",
      "question": "下列配平过程中，哪一步是错误的？FeS₂+O₂→Fe₂O₃+SO₂（高温）",
      "options": [
        "先将Fe₂O₃配为2使Fe守恒",
        "再将S配为4使S守恒",
        "最后O₂配为11使O守恒",
        "将所有系数改为分数更简便"
      ],
      "answer": 3,
      "explanation": "化学方程式系数应为最简整数比，不应使用分数。正确：4FeS₂+11O₂→2Fe₂O₃+8SO₂。",
      "errorType": "mc-balance-by-subscript",
      "remediationStep": "L29-S06",
      "knowledgeIds": [
        "equation-balancing"
      ]
    }
  ]
