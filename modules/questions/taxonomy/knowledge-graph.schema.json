{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"ChemLab Chemistry Knowledge Graph Node",
  "type":"object",
  "required":["id","name","relations"],
  "properties":{
    "id":{"type":"string"},
    "name":{"type":"string"},
    "chapter":{"type":"string"},
    "domain":{"type":"string"},
    "relations":{
      "type":"object",
      "properties":{
        "prerequisite":{"type":"array","items":{"type":"string"}},
        "related":{"type":"array","items":{"type":"string"}},
        "experiment":{"type":"array","items":{"type":"string"}},
        "question":{"type":"array","items":{"type":"string"}},
        "commonMistake":{"type":"array","items":{"type":"string"}}
      }
    },
    "bloomLevels":{"type":"array","items":{"type":"string"}}
  }
}
